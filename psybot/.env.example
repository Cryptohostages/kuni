# Скопируй этот файл в .env и заполни. Сам .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID психолога (и тех, кто ещё должен видеть кабинет), через запятую.
# Узнать свой ID можно у @userinfobot
ADMIN_IDS=

SCHOOL_NAME=Лицей № 1533 (ЛИТ)
PSYCHOLOGIST_NAME=
PSYCHOLOGIST_ROOM=

# --- Расписание ---
TIMEZONE=Europe/Moscow
# дни недели: 1 — понедельник, 7 — воскресенье
WORK_DAYS=1,2,3,4,5
DAY_START=09:00
DAY_END=17:00
# длительность встречи и перерыв после неё, в минутах
SLOT_MINUTES=45
BREAK_MINUTES=15
# true — рабочие дни сразу открыты для записи, психолог только закрывает лишнее;
# false — всё закрыто, психолог сам открывает нужное время
AUTO_OPEN=true

# --- Правила записи ---
# на сколько дней вперёд видно расписание
BOOKING_DAYS_AHEAD=14
# за сколько минут до начала запись закрывается
MIN_LEAD_MINUTES=60
# сколько будущих записей может быть у одного человека
MAX_ACTIVE_BOOKINGS=2
# сколько анонимных вопросов можно отправить за сутки
QUESTIONS_PER_DAY=5

# --- Напоминания ---
REMIND_DAY_BEFORE=true
# за сколько минут до встречи напомнить ещё раз (0 — не напоминать)
REMIND_MINUTES_BEFORE=60
# во сколько психологу приходит сводка на день (пусто — не присылать)
DIGEST_TIME=08:00

# --- Технические ---
DB_PATH=data/bot.sqlite3
# если Telegram недоступен напрямую: socks5://user:pass@host:port или http://host:port
PROXY_URL=
LOG_LEVEL=INFO
